---
interface Props {
  href: string;
  label: string;
  variant?: "solid" | "outline" | "ghost" | "cream";
  external?: boolean;
  class?: string;
  id?: string;
}

const {
  href,
  label,
  variant = "solid",
  external = false,
  class: className = "",
  id,
} = Astro.props;

const variants = {
  solid:
    "bg-rose text-white hover:bg-rose-deep border border-rose",
  outline:
    "bg-transparent text-white border border-white/70 hover:bg-white/10",
  ghost:
    "bg-white/10 text-white border border-white/25 backdrop-blur-sm hover:bg-white/20",
  cream:
    "bg-cream-soft text-rose-deep border border-rose/40 hover:bg-cream",
};
---

<a
  id={id}
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-medium tracking-wide transition duration-300",
    variants[variant],
    className,
  ]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <slot name="icon" />
  {label}
</a>
