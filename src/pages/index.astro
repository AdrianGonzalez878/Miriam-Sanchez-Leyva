---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { profile as p } from "../data/profile";

const waUrl = `https://wa.me/${p.whatsapp}?text=${encodeURIComponent(
  "Hola Azeret, vi tu perfil de Leyva Bakery y me gustaría platicar contigo."
)}`;

const horliBlocks = [
  { title: "Habilidades", items: p.horli.skills },
  { title: "Objetivos", items: p.horli.goals },
  { title: "Redes", items: p.horli.networks },
  { title: "Logros", items: p.horli.achievements },
  { title: "Intereses", items: p.horli.interests },
];
---

<Layout
  title={`${p.name} — ${p.business}`}
  description={`${p.title} · ${p.tagline} · ${p.location}`}
>
  <!-- HERO -->
  <header class="relative min-h-[100svh] overflow-hidden text-white">
    <img
      src={p.hero}
      alt="Pasteles artesanales de Leyva Bakery"
      class="hero-media absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/45 to-ink/80"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 hidden bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(44,31,32,0.35)_100%)] lg:block"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex min-h-[100svh] w-full max-w-lg flex-col px-6 pb-10 pt-8 md:max-w-3xl lg:max-w-5xl lg:px-10"
    >
      <div class="flex items-center justify-between animate-fade-up">
        <p class="text-[11px] uppercase tracking-[0.22em] text-cream/90 md:text-xs">
          Hecho con amor · Desde {p.since}
        </p>
        <img
          src={p.logo}
          alt="Leyva Bakery"
          class="h-11 w-auto rounded-md bg-white/95 object-contain px-2 py-1 shadow-sm md:h-14"
          width="120"
          height="56"
        />
      </div>

      <div
        class="mt-auto flex flex-col items-center text-center lg:items-start lg:text-left lg:pb-8"
      >
        <p
          class="font-script text-4xl text-cream animate-fade-up sm:text-5xl lg:text-6xl"
        >
          Leyva Bakery
        </p>
        <p class="mt-6 text-sm text-white/75 animate-fade-up-delay md:text-base">
          {p.greeting}
        </p>
        <h1
          class="mt-1 max-w-3xl font-display text-4xl font-medium leading-[1.05] tracking-tight animate-fade-up-delay sm:text-5xl lg:text-6xl"
        >
          {p.name}
        </h1>
        <p
          class="mt-4 max-w-xl text-sm leading-relaxed text-cream/90 animate-fade-up-delay-2 md:text-base"
        >
          {p.title}<br />
          {p.tagline} · {p.location}
        </p>

        <div
          class="mt-8 flex w-full max-w-md flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start animate-fade-up-delay-2"
        >
          <Button
            href={waUrl}
            label="WhatsApp"
            variant="solid"
            external
            class="w-full sm:w-auto"
          />
          <button
            type="button"
            id="share-btn"
            class="inline-flex w-full items-center justify-center gap-2 border border-white/70 bg-transparent px-5 py-3 text-sm font-medium tracking-wide text-white transition hover:bg-white/10 sm:w-auto"
          >
            Compartir perfil
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MARQUEE -->
  <div class="overflow-hidden bg-rose py-3 text-cream-soft md:py-4">
    <div class="marquee-track flex w-max gap-10 whitespace-nowrap md:gap-14">
      {[...p.pillars, ...p.pillars].map((item) => (
        <span class="font-display text-sm uppercase tracking-[0.2em] md:text-base">
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- VALUE -->
  <section class="bg-cream-soft section-pad">
    <div class="section-shell text-center reveal">
      <p class="font-script text-3xl text-rose md:text-4xl">{p.business}</p>
      <h2
        class="mx-auto mt-4 max-w-3xl font-display text-3xl leading-tight text-rose-deep text-balance sm:text-4xl lg:text-5xl"
      >
        {p.valueProposition.headline}
      </h2>
      <p
        class="mx-auto mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-muted md:text-base"
      >
        {p.valueProposition.body}
      </p>
      <p
        class="mx-auto mt-4 max-w-2xl text-[15px] font-medium leading-relaxed text-ink md:text-base"
      >
        {p.valueProposition.punchline}
      </p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="bg-blush section-pad">
    <div class="section-shell">
      <div
        class="flex flex-col items-center gap-8 reveal sm:flex-row sm:items-start lg:gap-12"
      >
        <div
          class="flex h-44 w-44 shrink-0 items-center justify-center rounded-2xl bg-white p-4 ring-4 ring-cream shadow-[0_20px_50px_-20px_rgba(216,125,129,0.55)] md:h-52 md:w-52"
        >
          <img
            src={p.photo}
            alt={`Logo de ${p.business}`}
            class="h-full w-full object-contain"
            width="176"
            height="176"
          />
        </div>
        <div class="text-center sm:text-left">
          <p class="text-xs uppercase tracking-[0.22em] text-rose">
            {p.about.eyebrow}
          </p>
          <h2 class="mt-2 font-display text-3xl text-ink md:text-4xl">
            {p.about.headline}
          </h2>
          <p class="mt-2 text-sm text-ink-muted">{p.yearsInBusiness}</p>
        </div>
      </div>

      <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="reveal reveal-delay-1">
          <p class="text-[15px] leading-relaxed text-ink-muted md:text-base">
            {p.about.body}
          </p>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-muted md:text-base">
            {p.about.body2}
          </p>
          <p class="mt-4 text-[15px] italic leading-relaxed text-rose-deep md:text-base">
            {p.about.secret}
          </p>
        </div>

        <dl
          class="grid gap-5 border-t border-rose/20 pt-8 reveal reveal-delay-2 sm:grid-cols-2 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10"
        >
          {p.about.facts.map((fact) => (
            <div>
              <dt class="text-[11px] uppercase tracking-[0.18em] text-rose">
                {fact.label}
              </dt>
              <dd class="mt-1 font-display text-xl text-ink md:text-2xl">
                {fact.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- CHEF / HIJA -->
  <section class="bg-cream-soft section-pad">
    <div class="section-shell">
      <p class="text-xs uppercase tracking-[0.22em] text-rose reveal">
        {p.chef.eyebrow}
      </p>
      <div
        class="mt-6 flex flex-col items-center gap-6 reveal reveal-delay-1 sm:flex-row sm:items-start lg:gap-10"
      >
        <img
          src={p.chef.photo}
          alt={`Retrato de ${p.chef.name}`}
          class="h-36 w-36 shrink-0 rounded-full object-cover object-top ring-4 ring-rose/30 md:h-44 md:w-44"
          width="176"
          height="176"
        />
        <div class="text-center sm:text-left">
          <h2 class="font-display text-3xl text-ink md:text-4xl">
            {p.chef.name}
          </h2>
          <p class="mt-1 text-sm text-rose-deep md:text-base">{p.chef.title}</p>
          <p
            class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink-muted md:text-base"
          >
            {p.chef.body}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CAREER -->
  <section class="bg-blush section-pad !py-12 md:!py-16">
    <div class="section-shell">
      <p class="text-xs uppercase tracking-[0.22em] text-rose reveal">
        {p.career.eyebrow}
      </p>
      <h2 class="mt-2 font-display text-3xl text-ink reveal reveal-delay-1 md:text-4xl">
        {p.career.headline}
      </h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {p.career.items.map((item, i) => (
          <li
            class:list={[
              "border-l-2 border-rose/40 pl-4 text-sm text-ink-muted reveal md:text-base",
              i % 3 === 1 ? "reveal-delay-1" : "",
              i % 3 === 2 ? "reveal-delay-2" : "",
            ]}
          >
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- IDEAL CLIENTS -->
  <section class="bg-rose section-pad text-white">
    <div class="section-shell">
      <div class="reveal max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-cream/80">
          {p.idealClients.eyebrow}
        </p>
        <h2 class="mt-2 font-display text-3xl text-cream-soft sm:text-4xl lg:text-5xl">
          {p.idealClients.headline}
        </h2>
        <p class="mt-3 text-sm text-white/80 md:text-base">
          {p.idealClients.intro}
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-10">
        <div class="reveal">
          <h3 class="font-display text-xl text-cream md:text-2xl">
            Busco trabajar con
          </h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-white/90 md:text-[15px]">
            {p.idealClients.seek.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cream" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-1">
          <h3 class="font-display text-xl text-cream md:text-2xl">
            Problemas que resuelvo
          </h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-white/90 md:text-[15px]">
            {p.idealClients.problems.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cream" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-2">
          <h3 class="font-display text-xl text-cream md:text-2xl">
            Señales de buena referencia
          </h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-white/90 md:text-[15px]">
            {p.idealClients.signals.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cream" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="bg-cream-soft section-pad">
    <div class="section-shell">
      <div class="reveal max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-rose">
          {p.clients.eyebrow}
        </p>
        <h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">
          {p.clients.headline}
        </h2>
        <p class="mt-3 text-sm text-ink-muted md:text-base">{p.clients.intro}</p>
      </div>

      <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4">
        {p.clients.items.map((client, i) => (
          <li
            class:list={[
              "lift border border-rose/20 bg-white/60 px-4 py-5 reveal",
              i % 3 === 1 ? "reveal-delay-1" : "",
              i % 3 === 2 ? "reveal-delay-2" : "",
            ]}
          >
            <span
              class="flex h-10 w-10 items-center justify-center bg-rose font-display text-sm text-white"
            >
              {client.initials}
            </span>
            <p class="mt-3 text-sm leading-snug text-ink md:text-[15px]">
              {client.name}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="bg-blush section-pad">
    <div class="section-shell">
      <div class="reveal">
        <p class="text-xs uppercase tracking-[0.22em] text-rose">Galería</p>
        <h2 class="mt-2 font-display text-3xl text-ink md:text-4xl">
          Nuestras <em class="italic text-rose-deep">creaciones</em>
        </h2>
        <p class="mt-3 text-sm text-ink-muted md:text-base">
          Pasteles de autor diseñados para momentos especiales.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4">
        {p.gallery.map((img, i) => (
          <figure
            class:list={[
              "gallery-item overflow-hidden reveal reveal-scale",
              i === 0 ? "col-span-2 md:col-span-2 md:row-span-2" : "",
              i === 1 ? "reveal-delay-1" : "",
              i === 2 ? "reveal-delay-2" : "",
            ]}
          >
            <img
              src={img.src}
              alt={img.alt}
              class:list={[
                "w-full object-cover",
                i === 0 ? "aspect-[4/5] md:aspect-auto md:h-full" : "aspect-[4/5]",
              ]}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-rose section-pad">
    <div class="section-shell">
      <div class="reveal">
        <p class="text-xs uppercase tracking-[0.22em] text-cream/80">
          Lo que dicen
        </p>
        <h2 class="mt-2 font-display text-3xl text-cream-soft md:text-4xl">
          Clientes felices
        </h2>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {p.testimonials.map((t, i) => (
          <blockquote
            class:list={[
              "px-5 py-4 text-ink reveal",
              i % 2 === 0 ? "bg-cream-soft" : "bg-white/90",
              i % 3 === 1 ? "reveal-delay-1" : "",
              i % 3 === 2 ? "reveal-delay-2" : "",
            ]}
          >
            <p class="text-sm font-semibold">{t.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">“{t.text}”</p>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ALLIES -->
  <section class="bg-cream-soft section-pad">
    <div class="section-shell">
      <div class="reveal max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-rose">
          {p.allies.eyebrow}
        </p>
        <h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">
          {p.allies.headline}
        </h2>
        <p class="mt-3 text-sm text-ink-muted md:text-base">{p.allies.intro}</p>
      </div>

      <ul
        class="mt-8 grid divide-y divide-rose/20 border-y border-rose/20 sm:grid-cols-2 sm:divide-x sm:divide-y-0 md:grid-cols-2 lg:grid-cols-3"
      >
        {p.allies.items.map((item, i) => (
          <li
            class:list={[
              "py-4 font-display text-xl text-ink reveal sm:px-5 md:text-2xl",
              i % 3 === 1 ? "reveal-delay-1" : "",
              i % 3 === 2 ? "reveal-delay-2" : "",
            ]}
          >
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HORLI -->
  <section class="bg-blush section-pad">
    <div class="section-shell">
      <div class="reveal max-w-3xl">
        <p class="text-xs uppercase tracking-[0.22em] text-rose">
          {p.horli.eyebrow}
        </p>
        <h2 class="mt-2 font-display text-3xl text-ink md:text-4xl">
          {p.horli.headline}
        </h2>
        <p class="mt-3 text-sm text-ink-muted md:text-base">{p.horli.intro}</p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {horliBlocks.map((block, i) => (
          <div
            class:list={[
              "border-l-2 border-rose/40 pl-5 reveal",
              i % 3 === 1 ? "reveal-delay-1" : "",
              i % 3 === 2 ? "reveal-delay-2" : "",
            ]}
          >
            <h3 class="font-display text-2xl text-rose-deep">{block.title}</h3>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-muted md:text-[15px]">
              {block.items.map((item) => (
                <li>· {item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="bg-ink section-pad text-white">
    <div class="section-shell text-center">
      <div class="reveal">
        <p class="font-script text-4xl text-cream md:text-5xl">Conectemos</p>
        <h2 class="mt-3 font-display text-3xl text-cream-soft md:text-4xl">
          ¿Conversamos?
        </h2>
        <p class="mt-3 text-sm text-white/70 md:text-base">
          Estoy a un mensaje. Elige el canal que prefieras.
        </p>
      </div>

      <a
        href={`tel:${p.phoneTel}`}
        class="mt-8 inline-block font-display text-2xl text-cream transition hover:text-white reveal reveal-delay-1 md:text-3xl"
      >
        {p.phoneDisplay}
      </a>

      <div
        class="mx-auto mt-8 grid max-w-xl grid-cols-2 gap-3 reveal reveal-delay-2"
      >
        <Button href={waUrl} label="WhatsApp" variant="solid" external class="w-full" />
        <Button
          href={p.instagramUrl}
          label="Instagram"
          variant="outline"
          external
          class="w-full"
        />
        <Button
          href={p.website}
          label="Sitio web"
          variant="ghost"
          external
          class="w-full"
        />
        <Button
          href={p.menuUrl}
          label="Ver menú"
          variant="ghost"
          external
          class="w-full"
        />
      </div>

      <div
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center reveal reveal-delay-2"
      >
        <button
          type="button"
          id="vcard-btn"
          class="inline-flex items-center justify-center border border-cream/40 px-5 py-3 text-sm text-cream transition hover:bg-white/10"
        >
          Guardar contacto
        </button>
        <button
          type="button"
          id="share-btn-footer"
          class="inline-flex items-center justify-center border border-cream/40 px-5 py-3 text-sm text-cream transition hover:bg-white/10"
        >
          Compartir perfil
        </button>
      </div>

      <div class="mt-12 flex flex-col items-center gap-3 reveal">
        <div
          id="qr-wrap"
          class="rounded-lg bg-white p-3"
          aria-label="Código QR del perfil"
        >
        </div>
        <p class="max-w-xs text-xs text-white/55">
          Escanea con la cámara para abrir este perfil.
        </p>
      </div>
    </div>
  </section>

  <footer class="bg-ink border-t border-white/10 px-6 py-8">
    <div
      class="section-shell flex flex-col items-center gap-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="text-center sm:text-left">
        <p class="font-script text-2xl text-rose-soft md:text-3xl">
          Leyva Bakery
        </p>
        <p class="mt-1 text-xs text-white/45">
          © {new Date().getFullYear()} · Oaxaca de Juárez, Oax
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <p class="text-[11px] uppercase tracking-[0.18em] text-white/45">
          Desarrollado por
        </p>
        <a
          href="https://argaweb.com"
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:opacity-85"
          aria-label="ARGA Desarrollo de Software — argaweb.com"
        >
          <img
            src="/images/arga.jpg"
            alt="ARGA Desarrollo de Software"
            class="h-12 w-auto rounded-md shadow-[0_6px_20px_-10px_rgba(0,0,0,0.6)] md:h-14"
            width="112"
            height="75"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
  </footer>

  <!-- Sticky WhatsApp -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="wa-float fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 md:bottom-8 md:right-8"
    aria-label="Escribir por WhatsApp"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 6.045L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
  </a>

  <script
    is:inline
    define:vars={{
      profileName: p.name,
      phoneTel: p.phoneTel,
      business: p.business,
      website: p.website,
      instagramUrl: p.instagramUrl,
      jobTitle: p.profession,
    }}
  >
    (function () {
      async function shareProfile() {
        const url = window.location.href;
        const title = `${profileName} — ${business}`;
        const text = `Conoce el perfil de ${profileName}, representante de ${business}.`;
        try {
          if (navigator.share) {
            await navigator.share({ title, text, url });
            return;
          }
        } catch (_) {}
        try {
          await navigator.clipboard.writeText(url);
          alert("Enlace copiado al portapapeles");
        } catch (_) {
          prompt("Copia este enlace:", url);
        }
      }

      function downloadVCard() {
        const lines = [
          "BEGIN:VCARD",
          "VERSION:3.0",
          `FN:${profileName}`,
          `ORG:${business}`,
          `TITLE:${jobTitle} · Representante`,
          `TEL;TYPE=CELL:${phoneTel}`,
          `URL:${website}`,
          `X-SOCIALPROFILE;TYPE=instagram:${instagramUrl}`,
          `NOTE:Leyva Bakery — Repostería de autor en Oaxaca`,
          "END:VCARD",
        ];
        const blob = new Blob([lines.join("\n")], {
          type: "text/vcard;charset=utf-8",
        });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "azeret-leyva-leyva-bakery.vcf";
        a.click();
        URL.revokeObjectURL(a.href);
      }

      document
        .getElementById("share-btn")
        ?.addEventListener("click", shareProfile);
      document
        .getElementById("share-btn-footer")
        ?.addEventListener("click", shareProfile);
      document
        .getElementById("vcard-btn")
        ?.addEventListener("click", downloadVCard);

      const qrWrap = document.getElementById("qr-wrap");
      if (qrWrap) {
        const src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(window.location.href)}`;
        const img = document.createElement("img");
        img.src = src;
        img.alt = "QR del perfil";
        img.width = 160;
        img.height = 160;
        img.className = "block";
        img.loading = "lazy";
        img.decoding = "async";
        qrWrap.appendChild(img);
      }

      // Scroll reveals — only if motion is allowed and IO exists
      var reduce =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var nodes = document.querySelectorAll(".reveal");

      if (reduce || !("IntersectionObserver" in window) || !nodes.length) {
        nodes.forEach(function (el) {
          el.classList.add("is-visible");
        });
        return;
      }

      document.documentElement.classList.add("js-anim");

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );

      nodes.forEach(function (el) {
        observer.observe(el);
      });
    })();
  </script>
</Layout>
